# Sourced by .local/bin/pi before exec'ing the real `pi` binary.
#
# auth.json can no longer be a nix-managed symlink: subscription/OAuth
# providers write tokens into it at login time, so it has to stay a
# regular, writable file. API-key providers are configured here instead,
# resolved from rspass at invocation time.

export DEEPSEEK_API_KEY="$(rspass show ai/deepseek/api/key/claude-code)"
export ZAI_CODING_CN_API_KEY="$(rspass show ai/zhipu/key/opencode)"
export KIMI_API_KEY="$(rspass show ai/kimi/coding/key/opencode)"

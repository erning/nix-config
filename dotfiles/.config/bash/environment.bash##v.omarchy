# Load environment variables exported by Home Manager.
hmSessionVars="$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh"
if [[ -r "$hmSessionVars" ]]; then
  source "$hmSessionVars"
fi
unset hmSessionVars

# Keep Home Manager and Omarchy-managed tools ahead of inherited PATH entries.
: "${OMARCHY_PATH:=/usr/share/omarchy}"
: "${HOMEBREW_PREFIX:=/home/linuxbrew/.linuxbrew}"

hmPreferredPath="$HOME/.local/bin"
if [[ -d "$OMARCHY_PATH/bin" && "$OMARCHY_PATH" != /usr/share/omarchy ]]; then
  hmPreferredPath="$hmPreferredPath:$OMARCHY_PATH/bin"
fi
hmPreferredPath="$hmPreferredPath:$HOME/.local/share/mise/shims"
hmPreferredPath="$hmPreferredPath:$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin"
hmPreferredPath="$hmPreferredPath:$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin"

export PATH="$(
  printf '%s:%s' "$hmPreferredPath" "$PATH" |
    awk -v RS=: '
      length($0) && !seen[$0]++ {
        output = output (length(output) ? ":" : "") $0
      }
      END { printf "%s", output }
    '
)"
unset hmPreferredPath

# DeepSeek

MODEL="deepseek-v4-pro"
MODEL_HS="deepseek-flash"

export ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic"
export ANTHROPIC_AUTH_TOKEN="$(rspass show ai/deepseek/api/key/claude-code)"

export ANTHROPIC_MODEL="${MODEL}"

export ANTHROPIC_DEFAULT_FABLE_MODEL="${MODEL}"
export ANTHROPIC_DEFAULT_OPUS_MODEL="${MODEL}"
export ANTHROPIC_DEFAULT_SONNET_MODEL="${MODEL_HS}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="${MODEL_HS}"
export CLAUDE_CODE_SUBAGENT_MODEL="${MODEL_HS}"


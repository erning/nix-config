# Kimi for Coding

MODEL="k3[1m]"
MODEL_HS="kimi-for-coding-highspeed"

export ANTHROPIC_BASE_URL="https://api.kimi.com/coding"
export ANTHROPIC_AUTH_TOKEN="$(rspass show ai/kimi/coding/key/claude-code)"

export ANTHROPIC_MODEL="${MODEL}"

export ANTHROPIC_DEFAULT_FABLE_MODEL="${MODEL}"
export ANTHROPIC_DEFAULT_OPUS_MODEL="${MODEL}"
export ANTHROPIC_DEFAULT_SONNET_MODEL="${MODEL_HS}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="${MODEL_HS}"
export CLAUDE_CODE_SUBAGENT_MODEL="${MODEL}"

export CLAUDE_CODE_AUTO_COMPACT_WINDOW=1048576
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=1048576
export CLAUDE_CODE_EFFORT_LEVEL=max

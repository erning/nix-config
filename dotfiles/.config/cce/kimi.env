# Kimi for Coding

MODEL_1="k3[1m]"
MODEL_2="k3-256k"

export ANTHROPIC_BASE_URL="https://api.kimi.com/coding"
export ANTHROPIC_AUTH_TOKEN="$(rspass show ai/kimi/coding/key/claude-code)"

export ANTHROPIC_MODEL="${MODEL_1}"

export ANTHROPIC_DEFAULT_FABLE_MODEL="${MODEL_1}"
export ANTHROPIC_DEFAULT_OPUS_MODEL="${MODEL_1}"
export ANTHROPIC_DEFAULT_SONNET_MODEL="${MODEL_2}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="${MODEL_2}"

export CLAUDE_CODE_SUBAGENT_MODEL="${MODEL_2}"
export CLAUDE_CODE_EFFORT_LEVEL=max

#export CLAUDE_CODE_AUTO_COMPACT_WINDOW=1048576
#export CLAUDE_CODE_MAX_CONTEXT_TOKENS=1048576

set -q OMARCHY_PATH; or set -gx OMARCHY_PATH /usr/share/omarchy

if test -d "$OMARCHY_PATH/bin"; and test "$OMARCHY_PATH" != /usr/share/omarchy
  contains -- "$OMARCHY_PATH/bin" $PATH; or set -gx PATH "$OMARCHY_PATH/bin" $PATH
end

set -l miseShims "$HOME/.local/share/mise/shims"
contains -- "$miseShims" $PATH; or set -gx PATH $PATH "$miseShims"
set -e miseShims

if status is-interactive
  set -q EDITOR; or set -gx EDITOR "omarchy-launch-editor --inline"
  set -gx SUDO_EDITOR "$EDITOR"
  set -q BROWSER; or set -gx BROWSER omarchy-launch-browser
  set -gx BAT_THEME ansi
  set -gx MANROFFOPT -c
  set -gx MANPAGER "sh -c 'col -bx | bat -l man -p'"
end

: ${OMARCHY_PATH:=/usr/share/omarchy}
export OMARCHY_PATH
: ${HOMEBREW_PREFIX:=/home/linuxbrew/.linuxbrew}
export HOMEBREW_PREFIX

preferredPath=("$HOME/.local/bin")
if [[ -d "$OMARCHY_PATH/bin" && "$OMARCHY_PATH" != /usr/share/omarchy ]]; then
  preferredPath+=("$OMARCHY_PATH/bin")
fi
preferredPath+=(
  "$HOME/.local/share/mise/shims"
  "$HOMEBREW_PREFIX/bin"
  "$HOMEBREW_PREFIX/sbin"
  "$HOME/.nix-profile/bin"
  /nix/var/nix/profiles/default/bin
)

path=("$preferredPath[@]" "$path[@]")
typeset -U path
unset preferredPath

# Enable mise's directory-aware environment updates in interactive shells.
if [[ -o interactive ]] && (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
fi

: ${EDITOR:="omarchy-launch-editor --inline"}
export EDITOR
export SUDO_EDITOR="$EDITOR"
: ${BROWSER:=omarchy-launch-browser}
export BROWSER
export BAT_THEME=ansi
export MANROFFOPT=-c
export MANPAGER="sh -c 'col -bx | bat -l man -p'"
